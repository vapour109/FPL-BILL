# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# Both are NEXT_PUBLIC_, so they ship to the browser — that's intended here, the
# app talks to Supabase directly from the client. Use the anon/publishable key,
# never the service_role key.
#
# Set these same two variables in Vercel (Project Settings → Environment
# Variables) when deploying. Apply supabase/schema.sql to the project first.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
