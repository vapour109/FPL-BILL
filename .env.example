# OPTIONAL. The app ships with the league's Supabase project baked into
# src/lib/supabase.ts, so it runs with no configuration at all.
#
# Set these only to point the app at a different Supabase project, or to rotate
# the committed key without a code change — they take precedence over the
# built-in defaults. Use the anon/publishable key, never the service_role key.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
